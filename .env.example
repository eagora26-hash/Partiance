# ============================================================
# PARTIANCE — Environment configuration
# Copy to `.env` and fill in. The app RUNS with just the CORE block;
# every SaaS block is optional and activates its provider when present.
# ============================================================

# ---- CORE (required) ----
NODE_ENV=development
APP_URL=http://localhost:3000
# Inside docker compose the host is `db`; for local `pnpm dev` use `localhost`.
DATABASE_URL=postgresql://partiance:partiance@localhost:5434/partiance?schema=public

# ---- AUTH.JS ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-insecure-secret-change-me-in-production
AUTH_TRUST_HOST=true

# ---- OAUTH (optional) ----
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# ---- PAYMENTS · Stripe (optional) ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- EMAIL · Resend (optional; logs to console if unset) ----
# RESEND_API_KEY=re_...
EMAIL_FROM=Partiance <no-reply@partiance.it>

# ---- ANALYTICS · PostHog (optional) ----
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ---- MONITORING · Sentry (optional) ----
# SENTRY_DSN=

# ---- AI (optional; deterministic fallback if unset) ----
# AI_API_KEY=
